APP_NAME=Academia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=database
DB_PORT=3306
DB_DATABASE=academia
DB_USERNAME=academia
# DB_PASSWORD se lee de secrets/db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD se lee de secrets/redis_password

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

FIREBASE_CREDENTIALS=/var/www/html/storage/app/private/firebase.json

# Usados por compose.production.yaml
APP_DOMAIN=app.example.com
ACME_EMAIL=
